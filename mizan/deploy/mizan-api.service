[Unit]
Description=Mizan Legal AI API
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mizan/backend
EnvironmentFile=/opt/mizan/backend/.env
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
