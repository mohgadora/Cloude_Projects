<%
  const baseUrl = process.env.BASE_URL || 'http://localhost:3000';
  const pageTitle = query ? 'نتائج البحث: ' + query : 'البحث';
  const pageDesc = query ? `نتائج البحث عن "${query}" - ${settings.site_name}` : settings.site_description;
  const pageCanonical = baseUrl + '/search' + (query ? '?q=' + encodeURIComponent(query) : '');
%>
<%- include('partials/head', { title: pageTitle, description: pageDesc, canonical: pageCanonical, ogImage: '', ogType: 'website', extraHead: '' }) %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="search-hero">
      <h1 class="search-title">
        <% if(query) { %>
          نتائج البحث عن "<span class="search-q"><%= query %></span>"
          <span class="search-count">(<%= total %> نتيجة)</span>
        <% } else { %>
          البحث في الموقع
        <% } %>
      </h1>
      <form action="/search" method="get" class="search-form-main">
        <input type="text" name="q" value="<%= query %>" placeholder="ابحث عن خبر..." class="search-input-main" autofocus>
        <button type="submit" class="search-btn-main"><i data-feather="search"></i> بحث</button>
      </form>
    </div>

    <div class="content-sidebar-grid">
      <div class="content-main">
        <% if(!query) { %>
        <div class="empty-state">
          <i data-feather="search"></i>
          <p>أدخل كلمة للبحث في الموقع</p>
        </div>
        <% } else if(articles.length === 0) { %>
        <div class="empty-state">
          <i data-feather="frown"></i>
          <p>لم يتم العثور على نتائج لـ "<%= query %>"</p>
          <a href="/" class="btn-primary">العودة للرئيسية</a>
        </div>
        <% } else { %>
        <div class="articles-grid">
          <% articles.forEach(article => { %>
          <article class="article-card">
            <a href="/article/<%= article.slug %>" class="card-img-link">
              <% if(article.image_url) { %>
              <img src="<%= article.image_url %>" alt="<%= article.title %>" class="card-img" loading="lazy">
              <% } else { %>
              <div class="card-img-placeholder"><i data-feather="image"></i></div>
              <% } %>
            </a>
            <div class="card-body">
              <a href="/category/<%= article.category_slug %>" class="card-cat" style="color:<%= article.category_color %>">
                <i data-feather="tag"></i> <%= article.category_name %>
              </a>
              <h3 class="card-title"><a href="/article/<%= article.slug %>"><%= article.title %></a></h3>
              <p class="card-excerpt"><%= article.excerpt ? article.excerpt.substring(0,120) + '...' : '' %></p>
              <div class="card-meta">
                <span><i data-feather="user"></i> <%= article.author_name %></span>
                <span><i data-feather="clock"></i> <%= new Date(article.created_at).toLocaleDateString('ar-SA') %></span>
              </div>
            </div>
          </article>
          <% }) %>
        </div>

        <% if(pages > 1) { %>
        <div class="pagination">
          <% if(page > 1) { %><a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= page-1 %>" class="page-btn"><i data-feather="chevron-right"></i> السابق</a><% } %>
          <% for(let p=1; p<=pages; p++) { %>
          <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= p %>" class="page-btn <%= p===page ? 'active' : '' %>"><%= p %></a>
          <% } %>
          <% if(page < pages) { %><a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= page+1 %>" class="page-btn">التالي <i data-feather="chevron-left"></i></a><% } %>
        </div>
        <% } %>
        <% } %>
      </div>

      <aside class="sidebar">
        <div class="widget">
          <h3 class="widget-title"><i data-feather="grid"></i> الأقسام</h3>
          <div class="cat-list">
            <% categories.forEach(cat => { %>
            <a href="/category/<%= cat.slug %>" class="cat-item" style="border-right-color:<%= cat.color %>">
              <span class="cat-name"><%= cat.name %></span>
              <span class="cat-count" style="background:<%= cat.color %>"><%= cat.article_count %></span>
            </a>
            <% }) %>
          </div>
        </div>
      </aside>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
