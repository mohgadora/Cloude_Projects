<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <h3 class="footer-logo"><%= settings.site_name %></h3>
      <p class="footer-desc"><%= settings.site_description %></p>
      <div class="footer-social">
        <% if(settings.facebook_url) { %><a href="<%= settings.facebook_url %>" target="_blank" class="social-btn fb"><i data-feather="facebook"></i></a><% } %>
        <% if(settings.twitter_url) { %><a href="<%= settings.twitter_url %>" target="_blank" class="social-btn tw"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.742l7.74-8.855L1.5 2.25H8.07l4.253 5.624 5.921-5.624zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a><% } %>
        <% if(settings.linkedin_url) { %><a href="<%= settings.linkedin_url %>" target="_blank" class="social-btn li"><i data-feather="linkedin"></i></a><% } %>
      </div>
    </div>

    <div class="footer-section">
      <h4 class="footer-title">الأقسام</h4>
      <ul class="footer-links">
        <% categories.slice(0,6).forEach(cat => { %>
        <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
        <% }) %>
      </ul>
    </div>

    <div class="footer-section">
      <h4 class="footer-title">روابط مهمة</h4>
      <ul class="footer-links">
        <li><a href="/">الرئيسية</a></li>
        <li><a href="/sitemap.xml">خريطة الموقع</a></li>
        <li><a href="/news-sitemap.xml">خريطة أخبار غوغل</a></li>
        <% if(settings.contact_email) { %><li><a href="mailto:<%= settings.contact_email %>">تواصل معنا</a></li><% } %>
      </ul>
    </div>

    <div class="footer-section">
      <h4 class="footer-title">ابحث في الموقع</h4>
      <form action="/search" method="get" class="footer-search">
        <input type="text" name="q" placeholder="بحث..." class="footer-search-input">
        <button type="submit"><i data-feather="search"></i></button>
      </form>
      <p class="footer-contact"><i data-feather="mail"></i> <%= settings.contact_email || '' %></p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© <%= new Date().getFullYear() %> <%= settings.site_name %> - جميع الحقوق محفوظة</p>
  </div>
</footer>

<script>
  feather.replace();
  // Set date in topbar
  const d = new Date();
  const opts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
  const el = document.getElementById('topbarDate');
  if(el) el.textContent = d.toLocaleDateString('ar-SA', opts);

  function toggleMenu() {
    document.getElementById('mainNav').classList.toggle('open');
  }

  function logout() {
    fetch('/api/auth/logout', { method: 'POST' })
      .then(() => window.location.href = '/');
  }
</script>
</body>
</html>
